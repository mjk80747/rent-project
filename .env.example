# Local development
MONGODB_URI=mongodb://localhost:27017/rent-project
TOKEN_KEY=your_super_secret_jwt_key_change_this_in_production
NODE_ENV=development

# Vercel production (set these in Vercel dashboard, NOT in .env)
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/rent-project?retryWrites=true&w=majority
# TOKEN_KEY=your_production_jwt_secret
# NODE_ENV=production
# FRONTEND_URL=https://rent-project-kappa.vercel.app
#
# MongoDB Atlas setup for Vercel:
# 1. Create a free cluster at https://www.mongodb.com/atlas
# 2. Database Access -> create a user
# 3. Network Access -> allow 0.0.0.0/0
# 4. Copy the connection string into Vercel MONGODB_URI
